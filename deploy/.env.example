# PostgreSQL (используется compose'ом и migrator'ом)
POSTGRES_DB=assistants
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Приложение
LOG_LEVEL=INFO

# Langflow (уже развёрнут отдельно, просто указываем адрес API)
LANGFLOW_BASE_URL=
# API-ключ (Settings → API Keys в UI Langflow). Обязателен для v1.5+.
LANGFLOW_API_KEY=

# Для системных тестов (см. tests/system): id готового flow в Langflow
LANGFLOW_TEST_FLOW_ID=
